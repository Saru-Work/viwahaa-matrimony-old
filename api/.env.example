# ── Server ────────────────────────────────────────────────
NODE_ENV=development

# ── Database (MySQL) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=viwahaa

# ── Prisma ─────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/viwahaa

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── QuickSend SMS ──────────────────────────────────────────
QUICKSEND_ENABLED=true
QUICKSEND_BASE_URL=
QUICKSEND_SENDER_ID=
QUICKSEND_EMAIL=
QUICKSEND_API_KEY=
QUICKSEND_METHOD=POST
QUICKSEND_TIMEOUT_MS=10000
QUICKSEND_INSTALLMENT_DUE_DAYS=30
QUICKSEND_DISCOUNT_ALERT_ENABLED=true
