# Nginx config for Viwahaa Matrimony
# Place this at: /etc/nginx/sites-available/viwahaa
# Then: sudo ln -s /etc/nginx/sites-available/viwahaa /etc/nginx/sites-enabled/
# Then: sudo nginx -t && sudo systemctl restart nginx

server {
    # TESTING (no domain): use port 8080 to avoid conflicts with other Nginx projects
    # Access via: http://YOUR_VPS_IP:8080
    # PRODUCTION (domain assigned): change to:  listen 80;  and  server_name viwaha.com www.viwaha.com;
    listen 8080;
    server_name _;

    # Serve React build (frontend)
    root /var/www/viwahaa-frontend-latest;
    index index.html;

    # React Router SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy all /api/* requests to Express backend
    location /api/ {
        proxy_pass http://localhost:7001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # Proxy /uploads/* (Multer file storage)
    location /uploads/ {
        proxy_pass http://localhost:7001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Proxy Socket.io
    location /socket.io/ {
        proxy_pass http://localhost:7001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
